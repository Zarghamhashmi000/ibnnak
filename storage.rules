rules_version = '2';

// Ibnnak — Firebase Storage security rules
// Public can READ product/blog images (they render on the shop).
// Only signed-in admins can UPLOAD/DELETE images.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
