rules_version = '2';

// Ibnnak — Firestore security rules
// Public can READ everything (shop, blog, content).
// Only signed-in admins (Firebase Authentication) can WRITE.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
