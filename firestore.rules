rules_version = '2';

// Ibnaak — Firestore security rules
// Public can READ everything.
// Only signed-in admins can WRITE books, posts, categories, etc.
// EXCEPTION: anyone (signed-out visitors) may CREATE a document in
// `submissions` only, and only with status "pending" — that is how
// submit.html sends work for admin approval. Visitors cannot update,
// delete, or publish submissions, and cannot write anything else.
// Admin (signed-in) can update submission status on approval/rejection.

service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.author is string
        && request.resource.data.keys().hasAll(['type','title','author','description','status']);
      allow update, delete: if request.auth != null;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
